export default async function handler(req, res) {
  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Método não permitido' });
  }

  try {
    const { total } = req.body;
    
    // Suas credenciais de Sandbox (Modo Teste)
    const clientId = "cms0q5i6j0 00elp019xciyps3";
    const clientSecret = "cc1fb9f755f42dee769767b7a335afde243890689c0ee43ab78acb0c58c8f5a4";

    // 1. Pegar o Token de Acesso
    const tokenRes = await fetch('https://api.novapay.com.br/oauth/token', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        client_id: clientId,
        client_secret: clientSecret,
        grant_type: 'client_credentials'
      })
    });

    const tokenData = await tokenRes.json();
    const accessToken = tokenData.access_token;

    // 2. Gerar o Pix
    const pixRes = await fetch('https://api.novapay.com.br/v1/charges', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${accessToken}`
      },
      body: JSON.stringify({
        amount: Math.round(total * 100), // Converte para centavos
        payment_method: "PIX"
      })
    });

    const pixData = await pixRes.json();

    // Retorna os dados para o seu site
    res.status(200).json({
      qrCode: pixData.qr_code, // Ajuste conforme a resposta real da API
      copyPaste: pixData.qr_code_string // Ajuste conforme a resposta real da API
    });

  } catch (error) {
    res.status(500).json({ error: error.message });
  }
}
